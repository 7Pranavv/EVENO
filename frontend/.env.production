# Build-time configuration for production builds (Vercel reads this).
#
# ONLY NEXT_PUBLIC_* values belong here. They are compiled into the JavaScript
# the browser downloads, so they are public by definition — putting a real
# secret in this file publishes it. Database URIs and the Razorpay secret are
# backend concerns: they go in Render's environment variables, never in the
# repo.
#
# Next.js does NOT read .env.example — that file is documentation for humans.
# This is the one it actually loads.

# Public Descope project identifier. Safe to commit; it ships in the bundle.
NEXT_PUBLIC_DESCOPE_PROJECT_ID=P3Iy4Artmg6xYyudQJhTrZhTw8pA

# CHANGE ME once the API is deployed — the browser calls this URL directly, so
# localhost only works when you are running the API on your own machine.
NEXT_PUBLIC_API_BASE=http://localhost:8080
