# Values for `docker compose`. Copy to .env and fill in.
# Each service also has its own .env.example for running without Docker.

# Descope project id — used by the API to verify sessions and baked into the
# browser bundle at build time.
DESCOPE_PROJECT_ID= 

# Razorpay keys. The secret signs and verifies payments; keep it off the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where the BROWSER should reach the API. Not an in-container hostname.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Origin the API accepts cross-origin requests from.
CORS_ORIGIN=http://localhost:3000
